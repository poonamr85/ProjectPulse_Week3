# Copy to .env and enter values locally. Never commit .env.
PROJECT_ID=PRJ-001
MEMORY_USER_ID=demo-user
DATABASE_PATH=data/project_status.sqlite3
NOTION_TOKEN=
# Paste database IDs or full database URLs. Optional DATA_SOURCE_ID overrides
# are useful when a database contains more than one data source.
NOTION_TASKS_DATABASE_ID=
NOTION_SPRINTS_DATABASE_ID=
NOTION_HISTORY_DATABASE_ID=
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_SPRINTS_DATA_SOURCE_ID=
NOTION_HISTORY_DATA_SOURCE_ID=
NOTION_VERSION=2025-09-03
MEM0_API_KEY=
# Reserved for the future agent stage; not required for steps 3–5.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=intelligent-project-status
LANGSMITH_AGENT_ENVIRONMENT=development
# Agent model provider. These credentials are separate from Mem0.
NEBIUS_API_KEY=
NEBIUS_MODEL=zai-org/GLM-5.3-Flash
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TIMEOUT_SECONDS=120
AGENT_CHECKPOINT_PATH=data/agent_checkpoints.sqlite3

# Interactive Q&A: per-model-request timeout; automatic retries are disabled.
NEBIUS_QA_TIMEOUT_SECONDS=60
